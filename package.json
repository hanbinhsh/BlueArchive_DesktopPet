{
  "name": "blue-archive-desktop-pet",
  "version": "0.2.28",
  "private": true,
  "description": "Offline Windows 3D desktop companion",
  "author": "BA Desktop Pet",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --x64 --dir",
    "verify-assets": "node scripts/verify-assets.mjs",
    "pack:zip": "npm run build && electron-builder --win zip --x64"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "tsx": "^4.20.0",
    "playwright": "^1.55.0"
  },
  "build": {
    "appId": "local.bluearchive.desktoppet",
    "productName": "BA Desktop Pet",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "characters",
        "to": "characters"
      },
      {
        "from": "native/bin/wheel-forwarder.exe",
        "to": "native/wheel-forwarder.exe"
      }
    ],
    "extraFiles": [
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "docs/ASSETS.md",
        "to": "角色来源.md"
      },
      {
        "from": "docs/VALIDATION.md",
        "to": "验收记录.md"
      },
      {
        "from": "docs/COSTUMES.md",
        "to": "服装核对表.md"
      },
      {
