# Normalize line endings across platforms; keep generated binaries untouched.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.glb binary
*.gltf binary
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.dat binary
*.pak binary
*.asar binary
*.zip binary
*.7z binary